#!/usr/bin/env bash
# Engine test gate. Default: only the packages the diff against main affects (the
# changed packages and everything that imports them, tests included), -short, and
# the Go test cache. FULL=1 (the pin candidate / landing gate): every package, no
# -short, -count=1; it runs every test, including the long scenarios -short skips.
# BASE=<ref> changes what the diff is taken against (default main).
set -euo pipefail
cd "$(dirname "$0")/.."
export GOMAXPROCS="${GOMAXPROCS:-4}"
timeout_flag=(-timeout "${GO_TEST_TIMEOUT:-25m}")

if [ "${FULL:-}" = 1 ]; then
  exec go test -count=1 "${timeout_flag[@]}" ./...
fi

base=$(git merge-base "${BASE:-main}" HEAD) || { echo "test: cannot resolve BASE=${BASE:-main}" >&2; exit 1; }
top=$(git rev-parse --show-toplevel)
# Changed files, all repo-root-relative: committed since base, staged, unstaged, untracked.
# --no-renames: a move lists the deleted old path too, so the source side is seeded.
tracked=$(git -C "$top" diff --no-renames --name-only "$base" --) || { echo "test: git diff failed" >&2; exit 1; }
untracked=$(git -C "$top" ls-files --others --exclude-standard) || { echo "test: git ls-files failed" >&2; exit 1; }
changed=$(printf '%s\n%s\n' "$tracked" "$untracked" | sed '/^$/d' | sort -u)
[ -n "$changed" ] || { echo "test: no changes against $base; nothing to run (FULL=1 runs everything)"; exit 0; }

# package import path|repo-relative dir|imports (including test imports), one line per package.
if ! graph=$(go list -f '{{.ImportPath}}|{{.Dir}}|{{join .Imports " "}} {{join .TestImports " "}} {{join .XTestImports " "}}' ./... 2>/dev/null); then
  echo "test: go list failed (a package moved or does not load); running every package (-short)"
  exec go test -short "${timeout_flag[@]}" ./...
fi

# A changed file that is not a .go file inside a known package (docs, testdata,
# go.mod, scripts, files tests read at runtime) is unclassified: when unsure, run
# every package. A .go file selects its package and everything importing it.
affected=$(
  printf '%s\n' "$changed" | TOP="$top" GRAPH="$graph" awk '
    BEGIN {
      n = split(ENVIRON["GRAPH"], lines, "\n")
      top = ENVIRON["TOP"] "/"
      for (i = 1; i <= n; i++) {
        split(lines[i], f, "|")
        pk[i] = f[1]; dir[f[1]] = f[2]; imp[f[1]] = f[3]; bydir[f[2]] = f[1]
      }
      np = n
    }
    {
      path = $0
      if (path !~ /\.go$/) { all = 1; next }
      d = top path; sub(/\/[^\/]*$/, "", d)
      if (d in bydir) want[bydir[d]] = 1; else all = 1   # a deleted or moved-away package dir has no entry
      anygo = 1
    }
    END {
      if (all) { print "ALL"; exit }
      # excerptcheck holds the doc-excerpt and golden-output tests, which read Go
      # sources and build cmd/workflow at runtime: any Go change runs it.
      if (anygo) for (i = 1; i <= np; i++) if (pk[i] ~ /\/tools\/excerptcheck$/) want[pk[i]] = 1
      do {
        grew = 0
        for (i = 1; i <= np; i++) {
          p = pk[i]
          if (p in want) continue
          m = split(imp[p], deps, " ")
          for (j = 1; j <= m; j++) if (deps[j] in want) { want[p] = 1; grew = 1; break }
        }
      } while (grew)
      for (p in want) print p
    }' | sort -u
)
if [ -z "$affected" ]; then
  echo "test: the diff selects no package; nothing to run"
  exit 0
fi
if [ "$affected" = ALL ]; then
  echo "test: a changed file is not a Go file in a known package; running every package (-short)"
  exec go test -short "${timeout_flag[@]}" ./...
fi
echo "test: $(printf '%s\n' "$affected" | wc -l) affected package(s) of $(printf '%s\n' "$graph" | wc -l) (FULL=1 runs everything, long tests included)"
# shellcheck disable=SC2086
exec go test -short "${timeout_flag[@]}" $affected
